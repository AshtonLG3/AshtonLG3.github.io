{
  "name": "employment-clocking-system",
  "version": "0.7.28",
  "description": "Central clock-in and clock-out system for employee work time logging.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build:ui": "npx tailwindcss -i ./public/tailwind.css -o ./public/dist.css",
    "cap:sync": "npm run build:ui && npx cap sync",
    "cap:sync:android": "npm run build:ui && npx cap sync android",
    "cap:sync:android:supervisor": "npm run build:ui && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-supervisor-android.ps1",
    "cap:open:android": "npx cap open android",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:debug:supervisor": "cd android && gradlew.bat :supervisor-app:assembleDebug"
  },
  "keywords": [
    "clocking",
    "attendance",
    "timesheets"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/barcode-scanner": "^4.0.1",
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/haptics": "^5.0.0",
    "@capacitor/ios": "^5.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.8",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  }
}
